# Copy to .env and fill in.
FYOS_PORT=8080
FYOS_OEFFENTLICH_URL=http://localhost:8080
# The Hub's time zone (daily counters and time windows of schedules), e.g. Europe/Berlin; UTC if unset.
# TZ=Europe/Berlin
# Largest file in the file store (app "Files"), in MB; 25 if unset.
# FYOS_DATEIEN_MAX_MB=25
# Images from your own registry (built by the CI of the repos fyos-os and fyos-agent).
FYOS_BILD_WEB=registry.example.com/fyos/fyos-os/web:main
FYOS_BILD_HUB=registry.example.com/fyos/fyos-os/hub:main
FYOS_BILD_AGENT=registry.example.com/fyos/fyos-agent/runner:main
# Any OpenAI-compatible provider (locally e.g. a llama.cpp server, Ollama, vLLM).
FYOS_MODELL_BASIS_URL=http://host.docker.internal:11434/v1
FYOS_MODELL_NAME=qwen3:8b
FYOS_MODELL_SCHLUESSEL=
# Token between interface and runner; a random value, e.g. openssl rand -hex 24
FYOS_AGENT_TOKEN=
