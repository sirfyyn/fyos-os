# Kopieren nach .env und ausfüllen.
FYOS_PORT=8080
FYOS_OEFFENTLICH_URL=http://localhost:8080
# Zeitzone des Hubs (Tageszähler und Zeitfenster der Takte), z. B. Europe/Berlin; ohne Angabe UTC.
# TZ=Europe/Berlin
# Bilder aus der eigenen Registry (gebaut von der CI der Repos fyos-os und fyos-agent).
FYOS_BILD_WEB=registry.example.com/fyos/fyos-os/web:main
FYOS_BILD_HUB=registry.example.com/fyos/fyos-os/hub:main
FYOS_BILD_AGENT=registry.example.com/fyos/fyos-agent/openclaw:main
# Jeder OpenAI-kompatible Anbieter (lokal z. B. llama.cpp-Server, Ollama, vLLM).
FYOS_MODELL_BASIS_URL=http://host.docker.internal:11434/v1
FYOS_MODELL_NAME=qwen3:8b
FYOS_MODELL_SCHLUESSEL=
# Zufallswert, z. B. openssl rand -hex 24
FYOS_AGENT_TOKEN=
