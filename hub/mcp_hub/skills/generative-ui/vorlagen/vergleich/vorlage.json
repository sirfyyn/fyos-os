{
  "titel": "Comparison",
  "zweck": "Weigh options against each other: cards per option and a matrix of the criteria; for numeric criteria with a direction (hoch/niedrig = higher/lower is better) the best value is highlighted, the recommendation is marked.",
  "schema": {
    "type": "object",
    "required": ["optionen"],
    "properties": {
      "ueberschrift": {"type": "string"},
      "text": {"type": "string"},
      "herkunft": {"type": "string"},
      "kriterien": {
        "type": "array", "maxItems": 16,
        "items": {"type": "object", "required": ["schluessel"], "properties": {
          "schluessel": {"type": "string"}, "name": {"type": "string"}, "einheit": {"type": "string"},
          "besser": {"type": "string", "enum": ["hoch", "niedrig"]}
        }}
      },
      "optionen": {
        "type": "array", "minItems": 2, "maxItems": 6,
        "items": {"type": "object", "required": ["name"], "properties": {
          "name": {"type": "string"},
          "text": {"type": "string"},
          "empfohlen": {"type": "boolean"},
          "merkmale": {"type": "object", "description": "Value per criterion schluessel (number, text or true/false)"},
          "frage": {"type": "string"}
        }}
      }
    }
  },
  "beispiel": {
    "ueberschrift": "Two storage options",
    "herkunft": "Example values",
    "kriterien": [
      {"schluessel": "platz", "name": "Capacity", "einheit": "TB", "besser": "hoch"},
      {"schluessel": "kosten", "name": "Cost per month", "einheit": "€", "besser": "niedrig"},
      {"schluessel": "lokal", "name": "Data stays at home"}
    ],
    "optionen": [
      {"name": "Own server", "empfohlen": true, "text": "cheaper at the same capacity", "merkmale": {"platz": 8, "kosten": 6, "lokal": true}},
      {"name": "Rented storage", "merkmale": {"platz": 8, "kosten": 24, "lokal": false}}
    ]
  }
}
