{
  "titel": "Timeline",
  "zweck": "What happened when: events grouped by day, newest or oldest first, tone per event, a click asks about it.",
  "schema": {
    "type": "object",
    "required": ["ereignisse"],
    "properties": {
      "ueberschrift": {"type": "string"},
      "text": {"type": "string"},
      "herkunft": {"type": "string"},
      "reihenfolge": {"type": "string", "enum": ["neu", "alt"], "default": "neu"},
      "ereignisse": {
        "type": "array", "minItems": 1, "maxItems": 500,
        "items": {"type": "object", "required": ["zeit", "titel"], "properties": {
          "zeit": {"type": "string", "description": "ISO time"},
          "titel": {"type": "string"},
          "text": {"type": "string"},
          "ton": {"type": "string", "enum": ["gut", "warn", "schlecht", "info", "aus"]},
          "frage": {"type": "string"}
        }}
      }
    }
  },
  "beispiel": {
    "ueberschrift": "Operations today",
    "herkunft": "Example values",
    "ereignisse": [
      {"zeit": "2026-10-10T08:40:00+02:00", "titel": "Update installed", "text": "all checks green", "ton": "gut"},
      {"zeit": "2026-10-10T07:15:00+02:00", "titel": "Service slower", "text": "response time 2.1 s", "ton": "warn", "frage": "Why was the service slower at 7:15?"},
      {"zeit": "2026-10-09T23:55:00+02:00", "titel": "Backup finished", "ton": "info"}
    ]
  }
}
