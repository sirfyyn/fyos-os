{
  "titel": "Flow",
  "zweck": "Steps, paths and connections as an SVG flow: boxes with arrows, vertical (senkrecht) or horizontal (waagerecht; wraps when narrow), tone per step, a click asks about it.",
  "schema": {
    "type": "object",
    "required": ["schritte"],
    "properties": {
      "ueberschrift": {"type": "string"},
      "text": {"type": "string"},
      "herkunft": {"type": "string"},
      "richtung": {"type": "string", "enum": ["senkrecht", "waagerecht"], "default": "senkrecht"},
      "schritte": {
        "type": "array", "minItems": 1, "maxItems": 16,
        "items": {"type": "object", "required": ["titel"], "properties": {
          "titel": {"type": "string", "maxLength": 40},
          "text": {"type": "string", "maxLength": 60},
          "ton": {"type": "string", "enum": ["gut", "warn", "schlecht", "info", "aus"]},
          "farbe": {"type": "string", "enum": ["purple", "teal", "coral", "pink", "gray", "blue", "green", "amber", "red"], "description": "Statt ton: Kategorienfarbe"},
          "frage": {"type": "string"}
        }}
      }
    }
  },
  "beispiel": {
    "ueberschrift": "Path of a change",
    "schritte": [
      {"titel": "Commit the change", "text": "targeted tests", "farbe": "purple"},
      {"titel": "Pull Request", "text": "CI runs", "farbe": "teal"},
      {"titel": "Merge to main", "text": "images are built", "farbe": "amber"},
      {"titel": "Roll out", "text": "update the installation", "farbe": "gray", "frage": "How do I roll out the change?"}
    ]
  }
}
