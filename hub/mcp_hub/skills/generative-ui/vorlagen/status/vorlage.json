{
  "titel": "Status",
  "zweck": "Many things with their state (services, checks, devices): count per state, by group, filter \"problems only\", problems first, a click asks about it.",
  "schema": {
    "type": "object",
    "required": ["eintraege"],
    "properties": {
      "ueberschrift": {"type": "string"},
      "text": {"type": "string"},
      "herkunft": {"type": "string"},
      "eintraege": {
        "type": "array", "minItems": 1, "maxItems": 500,
        "items": {"type": "object", "required": ["name", "zustand"], "properties": {
          "name": {"type": "string"},
          "zustand": {"type": "string", "description": "gut/ok, warn, schlecht/fehler, info, aus"},
          "text": {"type": "string"},
          "gruppe": {"type": "string"},
          "frage": {"type": "string"}
        }}
      }
    }
  },
  "beispiel": {
    "ueberschrift": "Hub plugins",
    "herkunft": "Example values",
    "eintraege": [
      {"name": "skills", "zustand": "ok", "gruppe": "Core"},
      {"name": "werkstatt", "zustand": "ok", "gruppe": "Core"},
      {"name": "wetter", "zustand": "warn", "text": "credentials missing", "gruppe": "Add-ons", "frage": "Why is the plugin wetter missing its credentials?"},
      {"name": "notizen", "zustand": "fehler", "text": "storage unreachable", "gruppe": "Add-ons"}
    ]
  }
}
