{
  "titel": "Table",
  "zweck": "Many entries with several attributes: sortable by clicking the column, search, numbers and times formatted for the interface language, tone columns as badges.",
  "schema": {
    "type": "object",
    "required": ["spalten", "zeilen"],
    "properties": {
      "ueberschrift": {"type": "string"},
      "text": {"type": "string"},
      "herkunft": {"type": "string"},
      "spalten": {
        "type": "array", "minItems": 1, "maxItems": 12,
        "items": {"type": "object", "required": ["schluessel"], "properties": {
          "schluessel": {"type": "string"},
          "name": {"type": "string"},
          "typ": {"type": "string", "enum": ["text", "zahl", "zeit", "tag", "ton"], "default": "text", "description": "ton: value gut/warn/schlecht/info/aus as a badge"},
          "einheit": {"type": "string"},
          "nachkomma": {"type": "integer", "minimum": 0, "maximum": 4}
        }}
      },
      "zeilen": {"type": "array", "maxItems": 2000, "items": {"type": "object", "description": "Values per schluessel; optionally frage (click)"}},
      "sortiert": {"type": "string", "description": "schluessel of the initial sort; with a leading - descending"},
      "suche": {"type": "boolean", "default": true}
    }
  },
  "beispiel": {
    "ueberschrift": "Open tickets",
    "herkunft": "Example values",
    "spalten": [
      {"schluessel": "id", "name": "Ticket"},
      {"schluessel": "titel", "name": "Title"},
      {"schluessel": "zustand", "name": "State", "typ": "ton"},
      {"schluessel": "alter", "name": "Age", "typ": "zahl", "einheit": "h"}
    ],
    "zeilen": [
      {"id": "INC-101", "titel": "Answers come slowly", "zustand": "warn", "alter": 5, "frage": "What is the state of INC-101?"},
      {"id": "CHG-102", "titel": "Install the host update", "zustand": "info", "alter": 26},
      {"id": "INC-103", "titel": "Hallway camera without picture", "zustand": "schlecht", "alter": 49}
    ],
    "sortiert": "-alter"
  }
}
