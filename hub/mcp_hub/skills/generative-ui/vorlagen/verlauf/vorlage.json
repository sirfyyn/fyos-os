{
  "titel": "Trend",
  "zweck": "Development over time (or over a number): one or more lines with axes, crosshair with values, series can be shown and hidden.",
  "schema": {
    "type": "object",
    "required": ["serien"],
    "properties": {
      "ueberschrift": {"type": "string"},
      "text": {"type": "string"},
      "herkunft": {"type": "string"},
      "einheit": {"type": "string", "description": "Unit of the y values"},
      "x": {"type": "string", "enum": ["zeit", "zahl"], "default": "zeit", "description": "zeit: x as ISO time or milliseconds"},
      "y_ab_null": {"type": "boolean", "default": true},
      "serien": {
        "type": "array", "minItems": 1, "maxItems": 8,
        "items": {"type": "object", "required": ["name", "punkte"], "properties": {
          "name": {"type": "string"},
          "ton": {"type": "string", "enum": ["gut", "warn", "schlecht", "info", "aus"]},
          "punkte": {"type": "array", "maxItems": 5000, "items": {"type": "array", "minItems": 2, "maxItems": 2}}
        }}
      },
      "marken": {
        "type": "array", "maxItems": 20, "description": "Vertical markers (e.g. a rollout)",
        "items": {"type": "object", "required": ["x", "name"], "properties": {"x": {}, "name": {"type": "string"}}}
      }
    }
  },
  "beispiel": {
    "ueberschrift": "Response time per hour",
    "herkunft": "Example values",
    "einheit": "s",
    "serien": [
      {"name": "Service", "ton": "info", "punkte": [["2026-10-10T06:00", 1.4], ["2026-10-10T07:00", 1.6], ["2026-10-10T08:00", 2.1], ["2026-10-10T09:00", 1.7]]},
      {"name": "Target", "ton": "aus", "punkte": [["2026-10-10T06:00", 1.5], ["2026-10-10T09:00", 1.5]]}
    ],
    "marken": [{"x": "2026-10-10T08:15", "name": "Update installed"}]
  }
}
