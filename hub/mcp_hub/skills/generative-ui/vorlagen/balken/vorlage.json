{
  "titel": "Balken",
  "zweck": "Mengen vergleichen: waagerechte Balken je Eintrag, einfach (wert) oder gestapelt nach Teilen (werte), sortierbar, Teile ein- und ausblendbar.",
  "schema": {
    "type": "object",
    "required": ["reihen"],
    "properties": {
      "ueberschrift": {"type": "string"},
      "text": {"type": "string"},
      "herkunft": {"type": "string"},
      "einheit": {"type": "string"},
      "teile": {
        "type": "array", "maxItems": 8,
        "description": "Nur für gestapelte Balken: Reihenfolge, Name und Ton je Teil",
        "items": {"type": "object", "required": ["schluessel"], "properties": {
          "schluessel": {"type": "string"}, "name": {"type": "string"},
          "ton": {"type": "string", "enum": ["gut", "warn", "schlecht", "info", "aus"]},
          "aus": {"type": "boolean", "description": "Anfangs ausgeblendet"}
        }}
      },
      "reihen": {
        "type": "array", "minItems": 1, "maxItems": 200,
        "items": {"type": "object", "required": ["name"], "properties": {
          "name": {"type": "string"},
          "wert": {"type": "number"},
          "werte": {"type": "object", "additionalProperties": {"type": "number"}},
          "ton": {"type": "string", "enum": ["gut", "warn", "schlecht", "info", "aus"]},
          "frage": {"type": "string"}
        }}
      },
      "sortierung": {"type": "string", "enum": ["wert", "name", "keine"], "default": "wert"}
    }
  },
  "beispiel": {
    "ueberschrift": "Aufrufe je Plugin",
    "herkunft": "Beispielwerte",
    "teile": [
      {"schluessel": "ok", "name": "erfolgreich", "ton": "gut"},
      {"schluessel": "fehler", "name": "fehlgeschlagen", "ton": "schlecht"},
      {"schluessel": "abgebrochen", "name": "abgebrochen", "ton": "aus", "aus": true}
    ],
    "reihen": [
      {"name": "skills", "werte": {"ok": 74, "fehler": 6, "abgebrochen": 12}, "frage": "Was ist bei den Skills fehlgeschlagen?"},
      {"name": "werkstatt", "werte": {"ok": 17}},
      {"name": "gui", "werte": {"ok": 10, "abgebrochen": 2}}
    ]
  }
}
