{
  "titel": "Bars",
  "zweck": "Compare amounts: horizontal bars per entry, simple (wert) or stacked by parts (werte), sortable, parts can be shown and hidden.",
  "schema": {
    "type": "object",
    "required": ["reihen"],
    "properties": {
      "ueberschrift": {"type": "string"},
      "text": {"type": "string"},
      "herkunft": {"type": "string"},
      "einheit": {"type": "string"},
      "teile": {
        "type": "array", "maxItems": 8,
        "description": "Only for stacked bars: order, name and tone per part",
        "items": {"type": "object", "required": ["schluessel"], "properties": {
          "schluessel": {"type": "string"}, "name": {"type": "string"},
          "ton": {"type": "string", "enum": ["gut", "warn", "schlecht", "info", "aus"]},
          "aus": {"type": "boolean", "description": "Hidden at first"}
        }}
      },
      "reihen": {
        "type": "array", "minItems": 1, "maxItems": 200,
        "items": {"type": "object", "required": ["name"], "properties": {
          "name": {"type": "string"},
          "wert": {"type": "number"},
          "werte": {"type": "object", "additionalProperties": {"type": "number"}},
          "ton": {"type": "string", "enum": ["gut", "warn", "schlecht", "info", "aus"]},
          "frage": {"type": "string"}
        }}
      },
      "sortierung": {"type": "string", "enum": ["wert", "name", "keine"], "default": "wert"}
    }
  },
  "beispiel": {
    "ueberschrift": "Calls per plugin",
    "herkunft": "Example values",
    "teile": [
      {"schluessel": "ok", "name": "succeeded", "ton": "gut"},
      {"schluessel": "fehler", "name": "failed", "ton": "schlecht"},
      {"schluessel": "abgebrochen", "name": "cancelled", "ton": "aus", "aus": true}
    ],
    "reihen": [
      {"name": "skills", "werte": {"ok": 74, "fehler": 6, "abgebrochen": 12}, "frage": "What failed with the skills?"},
      {"name": "werkstatt", "werte": {"ok": 17}},
      {"name": "gui", "werte": {"ok": 10, "abgebrochen": 2}}
    ]
  }
}
