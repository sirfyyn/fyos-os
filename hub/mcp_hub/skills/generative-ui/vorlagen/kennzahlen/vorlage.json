{
  "titel": "Key figures",
  "zweck": "A few important numbers at a glance: tiles with value, unit, tone (gut/warn/schlecht) and optionally a small trend.",
  "schema": {
    "type": "object",
    "required": ["kacheln"],
    "properties": {
      "ueberschrift": {"type": "string"},
      "text": {"type": "string"},
      "herkunft": {"type": "string", "description": "Source and time, e.g. \"audit.stats, 10 Oct 09:03\""},
      "kacheln": {
        "type": "array", "minItems": 1, "maxItems": 24,
        "items": {
          "type": "object", "required": ["titel", "wert"],
          "properties": {
            "titel": {"type": "string"},
            "wert": {"type": ["number", "string"]},
            "einheit": {"type": "string"},
            "nachkomma": {"type": "integer", "minimum": 0, "maximum": 4},
            "ton": {"type": "string", "enum": ["gut", "warn", "schlecht", "info", "aus"]},
            "hinweis": {"type": "string"},
            "verlauf": {"type": "array", "items": {"type": "number"}, "maxItems": 200},
            "frage": {"type": "string", "description": "Written into the conversation after a click"}
          }
        }
      }
    }
  },
  "beispiel": {
    "ueberschrift": "Service today",
    "herkunft": "Example values",
    "kacheln": [
      {"titel": "Requests", "wert": 1284, "ton": "gut", "verlauf": [80, 95, 120, 110, 140, 160, 150]},
      {"titel": "Response time", "wert": 1.8, "einheit": "s", "nachkomma": 1, "ton": "warn", "hinweis": "Target below 1.5 s"},
      {"titel": "Errors", "wert": 3, "ton": "schlecht", "frage": "Which three errors were there today?"}
    ]
  }
}
